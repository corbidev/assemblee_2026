# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

NAME=ja2026
MARIADB_VERSION=11.7.0


###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=7o0bZi65KjgoqpXvkNCXaq7V6CGoJmZX
APP_SHARE_DIR=var/share
JWT_PASSPHRASE=zJawk1KsCOwu1PEXG6txlrYU0ChFxNR0XbeeEYbJd0MjmDCtNZixDJGpTicTz1g4
###< symfony/framework-bundle ###

# Mail
# Utilisé par Mailer et les commandes d'alerte (retry queue)
MAIL_FROM=noreply@mail.fr
RESET_PASSWORD_TOKEN_TTL_MINUTES=60
MAIL_TO=admin@mail.fr
SMTP_USER=user
SMTP_PASS=pass
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_SECUR=tls

# MariaDB / MySQL
# MYSQL_URL(_AUTH): hôte/IP vu par PHP (localhost, service Docker, etc.)

MYSQL_URL=127.0.0.1
MYSQL_DATABASE=${NAME}
MYSQL_USER=user
MYSQL_PASSWORD=password


# Ports SQL
SQL_LOCALHOST_PORT=3376
SQL_LOCALHOST_PORT_AUTH=3366



###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://ja.local
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Connexion DB principale (auth dans cette architecture)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_URL}:${SQL_LOCALHOST_PORT}/${MYSQL_DATABASE}?serverVersion=${MARIADB_VERSION}-MariaDB&charset=utf8mb4"

###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:2525

# DSN SMTP effectif construit depuis les variables SMTP ci-dessus
# MAILER_DSN=smtp://${SMTP_USER}:${SMTP_PASS}@${SMTP_HOST}:${SMTP_PORT}?encryption=${SMTP_SECUR}&auth_mode=login
###< symfony/mailer ###
APP_BASE_URL=http://ja.local
TRUSTED_HOSTS='^ja\.local$|^localhost$|^127\.0\.0\.1$'
